// Prisma schema for Pikaboo.
//
// NOTE ON PROVIDER: this runs against Postgres (originally prototyped on
// SQLite — role/status fields are still plain strings, not native enums,
// for that reason; see src/lib/constants.ts). For pure local scratch work
// with zero external services, you can point DATABASE_URL at a local
// SQLite file and switch `provider` back to "sqlite" temporarily, but the
// deployed app and the checked-in migrations target Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Users & auth -----------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("CUSTOMER") // CUSTOMER | VENDOR | ADMIN
  dateOfBirth   DateTime
  ageVerified   Boolean  @default(false)
  phone         String?
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  addresses          Address[]
  cart               Cart?
  orders             Order[]
  phoneVerifications PhoneVerificationCode[]
  rewards            Reward[]
  groupBuyEntries    GroupBuyParticipant[]
}

model PhoneVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  code      String
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("Home")
  line1     String
  line2     String?
  city      String
  state     String
  postal    String
  country   String  @default("US")
  isDefault Boolean @default(false)
}

model Vendor {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  contactEmail    String
  integrationType String   @default("MANUAL")
  discreetLabel   String   @default("Plain Box Co.")
  apiBaseUrl      String?
  apiKey          String?
  fieldMapping    String?
  approved        Boolean  @default(true)
  createdAt       DateTime @default(now())

  users      User[]
  products   Product[]
  orderItems OrderItem[]
  syncLogs   VendorSyncLog[]
}

model VendorSyncLog {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("RUNNING")
  itemsSynced  Int       @default(0)
  errorMessage String?
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]
}

model Product {
  id                  String            @id @default(cuid())
  vendorId            String
  vendor              Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id])
  title               String
  slug                String            @unique
  description         String
  price               Int
  compareAtPrice      Int?
  sku                 String
  stock               Int               @default(0)
  imageUrl            String
  discreetPackaging   Boolean           @default(true)
  isActive            Boolean           @default(true)
  source              String            @default("MANUAL")
  externalId          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  groupBuyEnabled     Boolean           @default(false)
  groupBuyTarget      Int?
  groupBuyPrice       Int?
  groupBuyWindowHours Int               @default(48)
  cartItems           CartItem[]
  orderItems          OrderItem[]
  groupBuySessions    GroupBuySession[]

  @@index([vendorId, externalId])
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id                String  @id @default(cuid())
  cartId            String
  cart              Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int     @default(1)
  unitPriceOverride Int?
  groupBuySessionId String?

  @@unique([cartId, productId])
}

model Reward {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  value      Int       @default(0)
  code       String    @unique
  redeemed   Boolean   @default(false)
  redeemedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

model GroupBuySession {
  id           String                @id @default(cuid())
  productId    String
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetCount  Int
  status       String                @default("OPEN")
  expiresAt    DateTime
  createdAt    DateTime              @default(now())
  completedAt  DateTime?
  participants GroupBuyParticipant[]
}

model GroupBuyParticipant {
  id        String          @id @default(cuid())
  sessionId String
  session   GroupBuySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime        @default(now())

  @@unique([sessionId, userId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            String      @default("PENDING")
  subtotal          Int
  discountTotal     Int         @default(0)
  appliedRewardId   String?
  shippingTotal     Int
  total             Int
  shippingLine1     String
  shippingLine2     String?
  shippingCity      String
  shippingState     String
  shippingPostal    String
  shippingCountry   String      @default("US")
  billingDescriptor String
  createdAt         DateTime    @default(now())
  items             OrderItem[]
  payments          Payment[]
}

model OrderItem {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  titleSnapshot     String
  priceSnapshot     Int
  quantity          Int
  fulfillmentStatus String    @default("UNFULFILLED")
  trackingNumber    String?
  shippedAt         DateTime?
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String   @default("mock")
  providerRef String
  status      String
  amount      Int
  createdAt   DateTime @default(now())
}

// --- Creator community foundation --------------------------------------
// IDs are intentionally scalar in this first migration. This keeps the
// marketplace schema isolated while the community payment/video providers
// are still being selected.

model CreatorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  displayName      String
  bio              String?
  avatarUrl        String?
  contactFee       Int      @default(0)
  sessionRate      Int      @default(0)
  isAvailable      Boolean  @default(false)
  isApproved       Boolean  @default(false)
  identityVerified Boolean  @default(false)
  ageVerified      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isApproved, isAvailable])
}

model ContactRequest {
  id               String    @id @default(cuid())
  requesterId      String
  creatorId        String
  creatorProfileId String
  fee              Int       @default(0)
  status           String    @default("PENDING")
  paymentRef       String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([creatorId, status])
  @@index([requesterId, status])
}

model VideoSession {
  id                String    @id @default(cuid())
  contactRequestId  String?
  customerId        String
  creatorId         String
  creatorProfileId  String
  status            String    @default("SCHEDULED")
  rate              Int       @default(0)
  platformFee       Int       @default(0)
  creatorAmount     Int       @default(0)
  provider          String?
  providerSessionId String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  createdAt         DateTime  @default(now())

  @@index([creatorId, status])
  @@index([customerId, status])
}

model Gift {
  id               String   @id @default(cuid())
  senderId         String
  recipientId      String
  creatorProfileId String
  videoSessionId   String?
  amount           Int
  label            String
  status           String   @default("PENDING")
  providerRef      String?
  createdAt        DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([videoSessionId])
}

model CreatorEarning {
  id               String    @id @default(cuid())
  creatorId        String
  creatorProfileId String
  videoSessionId   String?
  giftId           String?
  grossAmount      Int
  platformFee      Int       @default(0)
  netAmount        Int
  status           String    @default("PENDING")
  availableAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([creatorId, status])
}
