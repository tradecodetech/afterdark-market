# Postgres connection string. Locally, run a Postgres container or use a
# free hosted instance (Neon, Vercel Postgres). Example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL=""

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

NEXT_PUBLIC_SITE_NAME="Pikaboo"

# mock | (add your own after implementing a real PaymentProvider)
PAYMENT_PROVIDER="mock"

# Used by prisma/seed.ts to build the demo API vendor's feed URL.
APP_URL="http://localhost:3000"
